# ==============================================================================
# TECH JACK® / 7926 | Environment Configuration
# Copy to .env.local and fill in verified launch values. Never commit secrets.
# ==============================================================================

# Canonical site origin (HTTPS, no trailing slash; Gate 4 & Gate 6)
NEXT_PUBLIC_SITE_URL=https://www.techjack.site

# Optional label credit toggle ("AN ARTIST PROJECT UNDER MOVO STUDIOS")
NEXT_PUBLIC_SHOW_LABEL_CREDIT=true

# Search engine verification tokens (Gate 14)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow key for dynamic search engine notifications (Gate 15)
INDEXNOW_KEY=

# Embedded Sanity Studio (/studio) + Live CMS Integration
# Create a free project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Optional verified streaming & social URLs (leave blank until owner confirms)
NEXT_PUBLIC_SPOTIFY_URL=
NEXT_PUBLIC_APPLE_MUSIC_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_SOUNDCLOUD_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_X_URL=

# Optional verified contact routing emails (leave blank until owner confirms)
NEXT_PUBLIC_CONTACT_BOOKINGS_EMAIL=
NEXT_PUBLIC_CONTACT_PRESS_EMAIL=
NEXT_PUBLIC_CONTACT_MANAGEMENT_EMAIL=
NEXT_PUBLIC_CONTACT_COLLAB_EMAIL=

# Real backend endpoints for Signal (newsletter) and Contact forms
# Leave blank to keep forms honestly in pre-launch configuration state
SIGNAL_WEBHOOK_URL=
SIGNAL_WEBHOOK_SECRET=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Optional privacy-conscious analytics (e.g. Plausible / Umami endpoint)
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
